stopOrbiting = function(isTargetDead)
    isOrbiting = false
    if orbitConnection then orbitConnection:Disconnect() orbitConnection = nil end
    orbitButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    orbitButton.Text = "Orbit: OFF (N)"
    verticalOffset = 0
    resetCamera()

    if isTargetDead and tweenOnTargetDeath then
        local character = localPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
            TweenService:Create(hrp, tweenInfo, {CFrame = hrp.CFrame + Vector3.new(0, 30, 0)}):Play()
        end
    end
end

local function getClosestPlayer()
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local closestPlayer = nil
    local shortestDistance = math.huge
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= localPlayer and otherPlayer.Character then
            local targetHRP = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
            if targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
                local distance = (character.HumanoidRootPart.Position - targetHRP.Position).Magnitude
                if distance < shortestDistance then shortestDistance = distance closestPlayer = otherPlayer end
            end
        end
    end
    return closestPlayer
end

startOrbiting = function()
    if not isScriptActive then return end
    if not currentTarget and INSTANT_TARGET_ON_ORBIT then
        local closest = getClosestPlayer()
        if closest then selectTarget(closest) end
    end

    if not currentTarget or not currentTarget.Character then return end
    local character = localPlayer.Character
    local myHRP = character and character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    isOrbiting = true
    angle = 0
    verticalOffset = 0
    orbitButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    orbitButton.Text = "Orbit: ON (N)"

    setCameraTarget(currentTarget)

    orbitConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not isScriptActive or not isOrbiting or not currentTarget or not currentTarget.Character then stopOrbiting(true) return end
        local targetHRP = currentTarget.Character:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = currentTarget.Character:FindFirstChildOfClass("Humanoid")

        if not targetHRP or not targetHumanoid or targetHumanoid.Health <= 0 or not myHRP then
            if not relockOnRespawn then currentTarget = nil statusLabel.Text = "Locked Target: None" else statusLabel.Text = "Target Dead (Waiting Respawn...)" end
            stopOrbiting(true)
            return
        end

        angle = angle + (ORBIT_SPEED * deltaTime)
        local offsetX = math.cos(angle) * ORBIT_RADIUS
        local offsetZ = math.sin(angle) * ORBIT_RADIUS
        local targetPos = targetHRP.Position
        local newPosition = Vector3.new(targetPos.X + offsetX, targetPos.Y + verticalOffset, targetPos.Z + offsetZ)
        local lookCFrame = CFrame.lookAt(newPosition, targetPos)

        if isUpsideDown then myHRP.CFrame = lookCFrame * CFrame.Angles(0, 0, math.pi) else myHRP.CFrame = lookCFrame end
    end)
end

selectTarget = function(targetPlayer)
    if currentTarget == targetPlayer or targetPlayer == nil then
        currentTarget = nil
        statusLabel.Text = "Locked Target: None"
        stopOrbiting(false)
        resetCamera()
    else
        currentTarget = targetPlayer
        statusLabel.Text = "Locked Target: " .. targetPlayer.DisplayName
        if isOrbiting then stopOrbiting(false) startOrbiting() else setCameraTarget(currentTarget) end
    end
end

