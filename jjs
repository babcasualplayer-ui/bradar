local espCache = {}

local function createEsp(p)
    local drawings = {}
    drawings.boxoutline = newDrawing("Square") drawings.boxoutline.Thickness = 3 drawings.boxoutline.Filled = false drawings.boxoutline.Color = newColor3(0, 0, 0) drawings.boxoutline.Visible = false drawings.boxoutline.ZIndex = 1
    drawings.box = newDrawing("Square") drawings.box.Thickness = 1 drawings.box.Filled = false drawings.box.Color = ESP_SETTINGS.defaultcolor drawings.box.Visible = false drawings.box.ZIndex = 2
    drawings.healthoutline = newDrawing("Square") drawings.healthoutline.Thickness = 1 drawings.healthoutline.Filled = true drawings.healthoutline.Color = newColor3(0, 0, 0) drawings.healthoutline.Visible = false drawings.healthoutline.ZIndex = 1
    drawings.healthbar = newDrawing("Square") drawings.healthbar.Thickness = 1 drawings.healthbar.Filled = true drawings.healthbar.Color = newColor3(0, 255, 0) drawings.healthbar.Visible = false drawings.healthbar.ZIndex = 2
    drawings.nametag = newDrawing("Text") drawings.nametag.Size = 13 drawings.nametag.Center = true drawings.nametag.Outline = true drawings.nametag.Color = newColor3(1, 1, 1) drawings.nametag.Visible = false drawings.nametag.ZIndex = 3
    espCache[p] = drawings
end

local function removeEsp(p)
    if rawget(espCache, p) then
        for _, drawing in next, espCache[p] do drawing:Remove() end
        espCache[p] = nil
    end
end

local function updateEsp(p, esp)
    local character = p and p.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and character:FindFirstChild("Head")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if ESP_SETTINGS.enabled and character and hrp and head and humanoid and humanoid.Health > 0 then
        if ESP_SETTINGS.mode == "Target" and currentTarget ~= p then
            esp.box.Visible = false esp.boxoutline.Visible = false esp.healthbar.Visible = false esp.healthoutline.Visible = false esp.nametag.Visible = false
            return
        end

        local distance = (camera.CFrame.Position - hrp.Position).Magnitude
        if distance > ESP_SETTINGS.maxdistance then
            esp.box.Visible = false esp.boxoutline.Visible = false esp.healthbar.Visible = false esp.healthoutline.Visible = false esp.nametag.Visible = false
            return
        end

        local topWorld = head.Position + Vector3.new(0, 0.8, 0)
        local bottomWorld = hrp.Position - Vector3.new(0, 3.2, 0)

        local topPos, topOnScreen = camera:WorldToViewportPoint(topWorld)
        local bottomPos, bottomOnScreen = camera:WorldToViewportPoint(bottomWorld)

        if (topOnScreen or bottomOnScreen) and topPos.Z > 0 and bottomPos.Z > 0 then
            local boxHeight = math.abs(bottomPos.Y - topPos.Y)
            local boxWidth = boxHeight * 0.55
            local x = topPos.X - (boxWidth / 2)
            local y = topPos.Y

            local color = ESP_SETTINGS.teamcolor and p.TeamColor.Color or ESP_SETTINGS.defaultcolor
            if p.Team == localPlayer.Team then color = ESP_SETTINGS.allycolor end

            esp.box.Size = newVector2(boxWidth, boxHeight) esp.box.Position = newVector2(x, y) esp.box.Color = color esp.box.Visible = true
            esp.boxoutline.Size = esp.box.Size esp.boxoutline.Position = esp.box.Position esp.boxoutline.Visible = true

            if ESP_SETTINGS.showhealth then
                local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                local barHeight = boxHeight * healthPercent
                esp.healthoutline.Size = newVector2(3, boxHeight + 2) esp.healthoutline.Position = newVector2(x - 6, y - 1) esp.healthoutline.Visible = true
                esp.healthbar.Size = newVector2(1, barHeight) esp.healthbar.Position = newVector2(x - 5, y + (boxHeight - barHeight)) esp.healthbar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0) esp.healthbar.Visible = true
            else
                esp.healthbar.Visible = false esp.healthoutline.Visible = false
            end

            if ESP_SETTINGS.showname then
                esp.nametag.Text = p.DisplayName .. " [" .. math.floor(distance) .. "m]"
                esp.nametag.Position = newVector2(topPos.X, y - 18) esp.nametag.Visible = true
            else
                esp.nametag.Visible = false
            end
        else
            esp.box.Visible = false esp.boxoutline.Visible = false esp.healthbar.Visible = false esp.healthoutline.Visible = false esp.nametag.Visible = false
        end
    else
        esp.box.Visible = false esp.boxoutline.Visible = false esp.healthbar.Visible = false esp.healthoutline.Visible = false esp.nametag.Visible = false
    end
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer then createEsp(p) end end
