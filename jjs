local selectTarget, stopOrbiting, startOrbiting, resetCamera, setCameraTarget, stopCamLock, startCamLock

resetCamera = function()
    if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = localPlayer.Character:FindFirstChild("Humanoid")
    end
end

setCameraTarget = function(targetPlayer)
    local shouldSpectate = autoSpectate and (not SPECTATE_ON_ORBIT_ONLY or isOrbiting)
    if shouldSpectate and targetPlayer and targetPlayer.Character then
        local targetHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if targetHum then camera.CameraSubject = targetHum end
    end
end

local function getClosestPlayerForCamLock()
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local closestPlayer = nil
    local shortestDistance = MAX_CAM_LOCK_DISTANCE
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= localPlayer and otherPlayer.Character then
            local targetHRP = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
            if targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
                local distance = (character.HumanoidRootPart.Position - targetHRP.Position).Magnitude
                if distance < shortestDistance then shortestDistance = distance closestPlayer = otherPlayer end
            end
        end
    end
    return closestPlayer
end

stopCamLock = function()
    isCamLocked = false
    if camLockConnection then camLockConnection:Disconnect() camLockConnection = nil end
end

startCamLock = function()
    local target = getClosestPlayerForCamLock()
    if not target then return end
    isCamLocked = true
    camLockConnection = RunService.RenderStepped:Connect(function()
        if not isCamLocked or not target.Character then stopCamLock() return end
        local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = target.Character:FindFirstChildOfClass("Humanoid")
        if not targetHRP or not targetHumanoid or targetHumanoid.Health <= 0 then stopCamLock() return end
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetHRP.Position)
    end)
end

local function handleCharacterAdded(p)
    p.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        if currentTarget == p and relockOnRespawn and isScriptActive then
            statusLabel.Text = "Locked Target: " .. p.DisplayName
            setCameraTarget(p)
            if isOrbiting then startOrbiting() end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do handleCharacterAdded(p) end
Players.PlayerAdded:Connect(handleCharacterAdded)

RunService.RenderStepped:Connect(function(dt)
    if not isScriptActive then return end
    local shouldSpectate = autoSpectate and (not SPECTATE_ON_ORBIT_ONLY or isOrbiting)
    if (isOrbiting or (shouldSpectate and currentTarget)) and not isCamLocked then
        if CAMERA_MODE == "Smooth" then
            local targetCF = camera.CFrame
            smoothedCameraCFrame = smoothedCameraCFrame:Lerp(targetCF, math.clamp(dt * CAMERA_DELAY_SPEED, 0, 1))
            camera.CFrame = smoothedCameraCFrame
        elseif CAMERA_MODE == "Delayed" then
            local targetCF = camera.CFrame
            smoothedCameraCFrame = smoothedCameraCFrame:Lerp(targetCF, math.clamp(dt * (CAMERA_DELAY_SPEED * 0.5), 0, 1))
            camera.CFrame = smoothedCameraCFrame
        end
    end

    for p, drawings in next, espCache do
        if ESP_SETTINGS.teamcheck and p.Team == localPlayer.Team then
            drawings.box.Visible = false drawings.boxoutline.Visible = false drawings.healthbar.Visible = false drawings.healthoutline.Visible = false drawings.nametag.Visible = false
            continue
        end
        if drawings and p ~= localPlayer then updateEsp(p, drawings) end
    end
end)

