UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not isScriptActive then return end

    if isBindingCamLockKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape then
                CAM_LOCK_KEY = Enum.KeyCode.Unknown camLockKeyButton.Text = "Cam Lock Key: [None]"
            else
                CAM_LOCK_KEY = input.KeyCode camLockKeyButton.Text = "Cam Lock Key: [" .. input.KeyCode.Name .. "]"
            end
            camLockKeyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            isBindingCamLockKey = false
            return
        end
    end

    if gameProcessed then return end

    if input.KeyCode == FLY_TOGGLE_KEY then toggleFlight()
    elseif input.KeyCode == ORBIT_TOGGLE_KEY then if isOrbiting then stopOrbiting(false) else startOrbiting() end
    elseif input.KeyCode == TARGET_KEY then
        if currentTarget then selectTarget(nil) else
            local closest, shortestDist = nil, math.huge
            local myChar = localPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= localPlayer and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
                        local hum = other.Character:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local d = (myChar.HumanoidRootPart.Position - other.Character.HumanoidRootPart.Position).Magnitude
                            if d < shortestDist then shortestDist = d closest = other end
                        end
                    end
                end
            end
            if closest then selectTarget(closest) else statusLabel.Text = "No players found!" end
        end
    elseif input.KeyCode == CAM_LOCK_KEY and CAM_LOCK_KEY ~= Enum.KeyCode.Unknown then
        if isCamLocked then stopCamLock() else startCamLock() end
    elseif input.KeyCode == GO_UP_KEY and isOrbiting then verticalOffset = math.clamp(verticalOffset + HEIGHT_STEP, MIN_HEIGHT, MAX_HEIGHT)
    elseif input.KeyCode == GO_DOWN_KEY and isOrbiting then verticalOffset = math.clamp(verticalOffset - HEIGHT_STEP, MIN_HEIGHT, MAX_HEIGHT) end
end)

