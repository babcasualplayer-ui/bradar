local function stopFlight()
    isFlying = false
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    local character = localPlayer.Character
    if character and character:FindFirstChildOfClass("Humanoid") then character:FindFirstChildOfClass("Humanoid").PlatformStand = false end
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    flyButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    flyButton.Text = "Flight: OFF (T)"
end

local function startFlying()
    if not isScriptActive then return end
    local character = localPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true
    humanoid.PlatformStand = true
    hrp.CFrame = hrp.CFrame + Vector3.new(0, FLY_START_HEIGHT, 0)

    flyBodyVelocity = Instance.new("BodyVelocity") flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge) flyBodyVelocity.Velocity = Vector3.zero flyBodyVelocity.Parent = hrp
    flyBodyGyro = Instance.new("BodyGyro") flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge) flyBodyGyro.P = 20000 flyBodyGyro.CFrame = hrp.CFrame flyBodyGyro.Parent = hrp

    flyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    flyButton.Text = "Flight: ON (T)"

    flyConnection = RunService.RenderStepped:Connect(function()
        if not isScriptActive or not isFlying or not character or not hrp or not humanoid then stopFlight() return end
        flyBodyGyro.CFrame = camera.CFrame
        if isOrbiting then flyBodyVelocity.Velocity = Vector3.zero return end

        local moveVector = Vector3.zero
        local camCFrame = camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector + Vector3.new(0, -1, 0) end

        if moveVector.Magnitude > 0 then flyBodyVelocity.Velocity = moveVector.Unit * FLY_SPEED else flyBodyVelocity.Velocity = Vector3.zero end
    end)
end

local function toggleFlight()
    if isFlying then stopFlight() else startFlying() end
end

flySpeedInput.FocusLost:Connect(function()
    local val = tonumber(flySpeedInput.Text)
    if val then FLY_SPEED = math.clamp(val, 10, 1000) flySpeedInput.Text = tostring(FLY_SPEED) else flySpeedInput.Text = tostring(FLY_SPEED) end
end)

