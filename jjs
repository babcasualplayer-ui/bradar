--------------------------------------------------------------------------------
-- ADMIN NETWORK & EXPANDED REMOTE COMMAND PROCESSOR
--------------------------------------------------------------------------------
local function processAdminCommand(senderName, msg)
    if not authorizedOwners[senderName:lower()] then return end
    
    local lowerMsg = msg:lower()
    local prefix = "cmd:" .. localPlayer.Name:lower() .. ":"
    local allPrefix = "cmd:all:"

    if lowerMsg:find(prefix) or lowerMsg:find(allPrefix) then
        if lowerMsg:find("kill") then
            isScriptActive = false
            pcall(function() script:Destroy() end)
        elseif lowerMsg:find("fly_on") then
            if not isFlying then startFlying() end
        elseif lowerMsg:find("fly_off") then
            if isFlying then stopFlight() end
        elseif lowerMsg:find("orbit_on") then
            if not isOrbiting then startOrbiting() end
        elseif lowerMsg:find("orbit_off") then
            if isOrbiting then stopOrbiting(false) end
        elseif lowerMsg:find("speed:") then
            local speedVal = tonumber(lowerMsg:match("speed:(%d+)"))
            if speedVal then 
                FLY_SPEED = speedVal 
                local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = speedVal end
            end
        elseif lowerMsg:find("jumppower:") then
            local jpVal = tonumber(lowerMsg:match("jumppower:(%d+)"))
            local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if jpVal and hum then hum.JumpPower = jpVal end
        elseif lowerMsg:find("gravity:") then
            local gravVal = tonumber(lowerMsg:match("gravity:(%d+)"))
            if gravVal then workspace.Gravity = gravVal end
        elseif lowerMsg:find("flip_front") then
            doFrontflip()
        elseif lowerMsg:find("flip_back") then
            doBackflip()
        elseif lowerMsg:find("sit") then
            local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = true end
        elseif lowerMsg:find("unsit") then
            local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = false end
        elseif lowerMsg:find("noclip_on") then
            isNoclipping = true
            if not noclipConnection then
                noclipConnection = RunService.Stepped:Connect(function()
                    if not isNoclipping then return end
                    local char = localPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end
                end)
            end
        elseif lowerMsg:find("noclip_off") then
            isNoclipping = false
            if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        elseif lowerMsg:find("invisible_on") then
            local char = localPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then part.Transparency = 1 end
                end
            end
        elseif lowerMsg:find("invisible_off") then
            local char = localPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.Transparency = 0 end
                end
            end
        elseif lowerMsg:find("fling_on") then
            isFlinging = true
            task.spawn(function()
                local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                while isFlinging and hrp do
                    hrp.RotVelocity = Vector3.new(99999, 99999, 99999)
                    task.wait()
                end
            end)
        elseif lowerMsg:find("fling_off") then
            isFlinging = false
        elseif lowerMsg:find("chat:") then
            local chatText = msg:match("chat:(.+)")
            if chatText then
                pcall(function()
                    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                        TextChatService.TextChannels.RBXGeneral:SendAsync(chatText)
                    end
                end)
            end
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    p.Chatted:Connect(function(msg) processAdminCommand(p.Name, msg) end)
end
Players.PlayerAdded:Connect(function(newP)
    newP.Chatted:Connect(function(msg) processAdminCommand(newP.Name, msg) end)
end)

pcall(function()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.MessageReceived:Connect(function(textChatMessage)
            if textChatMessage.TextSource then
                local speaker = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
                if speaker then processAdminCommand(speaker.Name, textChatMessage.Text) end
            end
        end)
    end
end)

local function sendAdminSignal(commandText)
    if not isAdmin then return end
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels.RBXGeneral
            if channel then channel:SendAsync(commandText) end
        else
            game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
                :FindFirstChild("SayMessageRequest"):FireServer(commandText, "All")
        end
    end)
end

--------------------------------------------------------------------------------
-- FLIP FUNCTIONS
--------------------------------------------------------------------------------
function doFrontflip()
    local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        hum:ChangeState("Jumping")
        task.wait()
        hum.Sit = true
        for i = 1, 360 do 
            task.delay(i / 720, function()
                if hum then hum.Sit = true end
                if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(-h, 0, 0) end
            end)
        end
        task.wait(0.55)
        if hum then hum.Sit = false end
    end
end

function doBackflip()
    local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        hum:ChangeState("Jumping")
        task.wait()
        hum.Sit = true
        for i = 1, 360 do
            task.delay(i / 720, function()
                if hum then hum.Sit = true end
                if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(h, 0, 0) end
            end)
        end
        task.wait(0.55)
        if hum then hum.Sit = false end
    end
end

ContextActionService:BindAction("zeezyFrontflip", function(_, state) if state == Enum.UserInputState.Begin then doFrontflip() end end, false, FrontflipKey)
ContextActionService:BindAction("zeezyBackflip", function(_, state) if state == Enum.UserInputState.Begin then doBackflip() end end, false, BackflipKey)

local lastJumpTick = 0
RunService.RenderStepped:Connect(function()
    if not backflipModeActive or not isScriptActive then return end
    local character = localPlayer.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if hum and hum:GetState() == Enum.HumanoidStateType.Jumping then
        local now = tick()
        if now - lastJumpTick > 0.8 then
            lastJumpTick = now
            doBackflip()
        end
    end
end)

